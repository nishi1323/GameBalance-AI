# GameBalance AI - Example Environment Configuration
# Copy this file to .env (or export these variables in your shell) and fill in real values.

SERVER_PORT=8080
MONGODB_URI=mongodb://localhost:27017/GameBalanceAI
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters-long
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional Frontend API Base URL (defaults to /api via Vite proxy in development)
VITE_API_BASE_URL=/api
